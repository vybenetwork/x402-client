# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Required. Base58 (most wallets' "Export Private Key") or base64 (a
# solana-keygen JSON file piped through `base64`). The SDK auto-detects.
# Treat this as a secret — it's the FULL keypair, not just a pubkey.
# Use a dedicated wallet — see the README "Setup" section.
CLIENT_PRIVATE_KEY=

# Strongly recommended. The SDK signs each payment client-side, which calls
# Solana RPC twice per paid request. Without this, the SDK falls back to
# the public mainnet RPC (~5 RPS, throttles fast). Free tiers:
#   - Helius:    https://www.helius.dev/   (10 RPS, no card)
#   - Triton:    https://triton.one/
#   - QuickNode: https://www.quicknode.com/
SOLANA_RPC_URL=
